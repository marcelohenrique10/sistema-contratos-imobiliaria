<%- include("partials/header") %>

<div class="page-header">
  <h2>Usuários</h2>
  <p>Quem entra no sistema e o que cada um alcança.</p>
</div>

<% if (erro) { %>
  <div style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
    <%= erro %>
  </div>
<% } %>

<% if (aviso) { %>
  <div style="background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;padding:12px 16px;border-radius:8px;margin-bottom:20px;">
    <%= aviso %>
  </div>
<% } %>

<% if (senhaNova) { %>
  <div style="background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;padding:16px;border-radius:8px;margin-bottom:20px;">
    <strong style="display:block;margin-bottom:8px;">Anote agora — esta senha não aparece de novo.</strong>
    <p style="margin:0 0 10px;font-size:14px;">
      O sistema guarda a senha embaralhada, então nem eu nem você conseguem lê-la
      depois. Se perder, o caminho é gerar outra.
    </p>
    <div style="font-family:monospace;font-size:16px;background:#fff;border:1px solid #bbf7d0;padding:10px 14px;border-radius:6px;">
      login: <strong><%= loginNovo %></strong><br />
      senha: <strong><%= senhaNova %></strong>
    </div>
  </div>
<% } %>

<div class="form-card">
  <h3>Novo usuário</h3>
  <p style="color:#6b7280;font-size:14px;margin-top:-10px;margin-bottom:20px;">
    Você cria e entrega o login pronto. Não há cadastro por conta própria.
  </p>

  <form method="POST" action="/usuarios">
    <div class="form-grid">
      <div class="form-group">
        <label>Nome</label>
        <input type="text" name="nome" placeholder="Ex: Carla Menezes" required />
      </div>
      <div class="form-group">
        <label>Login</label>
        <input type="text" name="login" placeholder="carla@imobiliaria.com"
               autocapitalize="none" autocorrect="off" spellcheck="false" required />
      </div>
      <div class="form-group">
        <label>Senha inicial</label>
        <input type="text" name="senha" id="senha" minlength="8"
               placeholder="mínimo 8 caracteres" required />
        <small><button type="button" class="button secondary" id="gerar"
                style="font-size:12px;padding:4px 10px;margin-top:6px;">Gerar senha</button></small>
      </div>
      <div class="form-group">
        <label>Papel</label>
        <select name="papel" required>
          <option value="corretor">Corretor — espelho, clientes, contratos</option>
          <option value="admin">Administrador — tudo, inclusive financeiro</option>
        </select>
      </div>
    </div>
    <div class="actions" style="margin-top:16px;">
      <button type="submit" class="button">Criar usuário</button>
    </div>
  </form>
</div>

<table style="margin-top:24px;">
  <thead>
    <tr>
      <th>Nome</th>
      <th>Login</th>
      <th>Papel</th>
      <th>Situação</th>
      <th style="text-align:right;">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% lista.forEach(u => { %>
      <tr style="<%= u.ativo ? '' : 'opacity:.55;' %>">
        <td><strong><%= u.nome %></strong></td>
        <td style="font-family:monospace;font-size:13px;"><%= u.login %></td>
        <td>
          <span style="font-size:12px;padding:3px 9px;border-radius:5px;white-space:nowrap;
            background:<%= u.papel === 'admin' ? '#ede9fe' : '#e0f2fe' %>;
            color:<%= u.papel === 'admin' ? '#5b21b6' : '#075985' %>;">
            <%= u.papel === 'admin' ? 'Administrador' : 'Corretor' %>
          </span>
        </td>
        <td>
          <% if (u.ativo) { %>
            <span style="color:#166534;font-size:13px;">Ativo</span>
          <% } else { %>
            <span style="color:#b91c1c;font-size:13px;">Desativado</span>
          <% } %>
        </td>
        <td>
          <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;">
            <form method="POST" action="/usuarios/<%= u.id %>/senha" class="inline-form"
                  onsubmit="return this.senha.value.length >= 8 || (alert('A senha precisa de 8 caracteres ou mais.'), false);">
              <input type="text" name="senha" placeholder="nova senha" minlength="8"
                     style="width:150px;padding:5px 8px;font-size:12px;" />
              <button type="submit" class="button secondary" style="font-size:12px;padding:5px 10px;">Trocar senha</button>
            </form>

            <form method="POST" action="/usuarios/<%= u.id %>/ativo" class="inline-form"
                  <%= u.ativo ? "onsubmit=\"return confirm('Desativar " + u.nome + "? Ele deixa de entrar imediatamente.')\"" : '' %>>
              <input type="hidden" name="ativo" value="<%= u.ativo ? '0' : '1' %>" />
              <button type="submit" class="button <%= u.ativo ? 'danger' : '' %>"
                      style="font-size:12px;padding:5px 10px;">
                <%= u.ativo ? 'Desativar' : 'Reativar' %>
              </button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<script>
  document.getElementById('gerar').addEventListener('click', function () {
    // Sem caracteres que se confundem ao ditar por telefone: 0/O, 1/l/I
    var alfabeto = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789';
    var valores = new Uint32Array(12);
    crypto.getRandomValues(valores);
    document.getElementById('senha').value =
      Array.from(valores, function (v) { return alfabeto[v % alfabeto.length]; }).join('');
  });
</script>

<%- include("partials/footer") %>
