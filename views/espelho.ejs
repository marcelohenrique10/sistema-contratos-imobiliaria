<%- include("partials/header") %>

<script type="application/json" id="dados-unidades"><%- JSON.stringify(unidades).replace(/</g, '\\u003c') %></script>

<section class="page-header">
  <h2>Espelho de vendas</h2>
  <p>Toque numa unidade para ver os detalhes e reservar.</p>
</section>

<% if (erro) { %>
  <div style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca;padding:12px 16px;border-radius:8px;margin-bottom:16px;"><%= erro %></div>
<% } %>
<% if (aviso) { %>
  <div style="background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;padding:12px 16px;border-radius:8px;margin-bottom:16px;"><%= aviso %></div>
<% } %>

<section class="form-card">
  <form action="/espelho" method="GET">
    <div class="form-grid" style="margin-bottom:0;">
      <div class="form-group">
        <label for="empreendimento">Empreendimento</label>
        <select name="empreendimento" id="empreendimento" onchange="this.form.submit()">
          <% empreendimentos.forEach(e => { %>
            <option value="<%= e.id %>" <%= empreendimentoSelecionado && empreendimentoSelecionado.id === e.id ? 'selected' : '' %>><%= e.nome %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="status">Situação</label>
        <select name="status" id="status" onchange="this.form.submit()">
          <option value="todos" <%= statusFiltro === 'todos' ? 'selected' : '' %>>Todas (<%= total %>)</option>
          <% [['livre','Livres'],['negociacao','Em negociação'],['vendido','Vendidas'],['permutado','Permutadas'],['cancelado','Canceladas']].forEach(([v, r]) => { %>
            <% if (contagem[v]) { %>
              <option value="<%= v %>" <%= statusFiltro === v ? 'selected' : '' %>><%= r %> (<%= contagem[v] %>)</option>
            <% } %>
          <% }) %>
        </select>
      </div>

      <% if (pavimentos.length > 1) { %>
        <div class="form-group">
          <label for="pavimento">Pavimento</label>
          <select name="pavimento" id="pavimento" onchange="this.form.submit()">
            <option value="todos" <%= pavimentoFiltro === 'todos' ? 'selected' : '' %>>Todos</option>
            <% pavimentos.forEach(p => { %>
              <option value="<%= p %>" <%= pavimentoFiltro === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
      <% } %>
    </div>
  </form>
</section>

<% if (!empreendimentoSelecionado) { %>
  <div class="empty-state">Nenhum empreendimento disponível.</div>
<% } else { %>
  <section class="page-header" style="margin-bottom:12px;">
    <h3 style="margin-bottom:2px;"><%= empreendimentoSelecionado.nome %></h3>
    <p style="margin:0;"><%= empreendimentoSelecionado.endereco || '' %></p>
  </section>

  <% if (unidades.length === 0) { %>
    <div class="empty-state">
      <% if (total > 0) { %>
        Nenhuma unidade com esse filtro. <a href="/espelho?empreendimento=<%= empreendimentoSelecionado.id %>">Ver todas as <%= total %></a>.
      <% } else { %>
        Nenhuma unidade cadastrada para este empreendimento.
      <% } %>
    </div>
  <% } else { %>
    <p style="color:#6b7280;font-size:13px;margin:0 0 12px;">
      Mostrando <%= unidades.length %> de <%= total %> unidades.
    </p>

    <section class="mirror-grid">
      <% unidades.forEach(u => { %>
        <button type="button" class="unit-card status-<%= u.status %>" data-unidade="<%= u.id %>">
          <div class="unit-top">
            <span class="unit-number"><%= u.numero %></span>
            <span class="unit-status"><%= u.statusLabel %></span>
          </div>
          <p class="unit-meta"><%= [u.tipologia, u.metragem].filter(Boolean).join(' · ') %></p>
          <% if (u.clienteNome) { %>
            <p class="unit-cliente"><%= u.clienteNome %></p>
          <% } %>
        </button>
      <% }) %>
    </section>
  <% } %>
<% } %>

<!-- Painel de detalhe -->
<div id="painel" class="painel-fundo" hidden>
  <div class="painel-caixa" role="dialog" aria-modal="true" aria-labelledby="painel-titulo">
    <div class="painel-topo">
      <h3 id="painel-titulo">Unidade</h3>
      <button type="button" class="painel-fechar" id="fechar" aria-label="Fechar">&times;</button>
    </div>

    <div id="painel-corpo"></div>

    <div id="painel-acoes"></div>
  </div>
</div>

<script>
  const UNIDADES = JSON.parse(document.getElementById('dados-unidades').textContent);
  const EMPREENDIMENTO = "<%= empreendimentoSelecionado ? empreendimentoSelecionado.id : '' %>";
  const CLIENTES = <%- JSON.stringify(clientes.map(c => ({ id: c.id, nome: c.nome, doc: c.cpfCnpj || '' }))) %>;

  const painel = document.getElementById('painel');
  const titulo = document.getElementById('painel-titulo');
  const corpo = document.getElementById('painel-corpo');
  const acoes = document.getElementById('painel-acoes');
  let ultimoFoco = null;

  function linha(rotulo, valor) {
    if (!valor) return '';
    return '<div class="painel-linha"><span>' + rotulo + '</span><strong>' + valor + '</strong></div>';
  }

  function escapar(t) {
    return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  function abrir(id) {
    const u = UNIDADES.find(function (x) { return String(x.id) === String(id); });
    if (!u) return;

    ultimoFoco = document.activeElement;
    titulo.textContent = 'Unidade ' + u.numero;

    corpo.innerHTML =
      '<div class="painel-selo status-' + u.status + '">' + escapar(u.statusLabel) + '</div>' +
      linha('Pavimento', escapar(u.pavimento)) +
      linha('Tipologia', escapar(u.tipologia)) +
      linha('Metragem', escapar(u.metragem)) +
      linha('Cliente', escapar(u.clienteNome)) +
      linha('Reservada por', escapar(u.reservadoPorNome)) +
      linha('Reservada em', u.reservadoEm ? escapar(u.reservadoEm.slice(0, 10).split('-').reverse().join('/')) : '');

    if (u.status === 'livre') {
      if (CLIENTES.length === 0) {
        acoes.innerHTML =
          '<div class="painel-aviso">Para reservar é preciso ter um cliente cadastrado. ' +
          '<a href="/clientes">Cadastrar cliente</a>.</div>';
      } else {
        acoes.innerHTML =
          '<form method="POST" action="/unidades/' + u.id + '/reservar" class="painel-form">' +
          '<input type="hidden" name="empreendimento" value="' + EMPREENDIMENTO + '" />' +
          '<label for="clienteId">Reservar para qual cliente?</label>' +
          '<select name="clienteId" id="clienteId" required>' +
          '<option value="">Selecione um cliente</option>' +
          CLIENTES.map(function (c) {
            return '<option value="' + c.id + '">' + escapar(c.nome) + (c.doc ? ' — ' + escapar(c.doc) : '') + '</option>';
          }).join('') +
          '</select>' +
          '<small>Só clientes já cadastrados. Isso é o que registra quem reservou primeiro.</small>' +
          '<button type="submit" class="button">Reservar unidade</button>' +
          '</form>';
      }
    } else if (u.status === 'negociacao' && u.podeLiberar) {
      acoes.innerHTML =
        '<form method="POST" action="/unidades/' + u.id + '/liberar" class="painel-form"' +
        ' onsubmit="return confirm(\'Liberar a unidade ' + u.numero + '? Ela volta a ficar livre para qualquer corretor.\')">' +
        '<input type="hidden" name="empreendimento" value="' + EMPREENDIMENTO + '" />' +
        '<button type="submit" class="button danger">Desfazer reserva</button>' +
        '</form>';
    } else if (u.status === 'negociacao') {
      acoes.innerHTML =
        '<div class="painel-aviso">Reserva de ' + escapar(u.reservadoPorNome || 'outro corretor') +
        '. Só ele ou um administrador pode desfazer.</div>';
    } else {
      acoes.innerHTML = '';
    }

    painel.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('fechar').focus();
  }

  function fechar() {
    painel.hidden = true;
    document.body.style.overflow = '';
    if (ultimoFoco) ultimoFoco.focus();
  }

  document.querySelectorAll('[data-unidade]').forEach(function (card) {
    card.addEventListener('click', function () { abrir(this.dataset.unidade); });
  });

  document.getElementById('fechar').addEventListener('click', fechar);
  painel.addEventListener('click', function (e) { if (e.target === painel) fechar(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !painel.hidden) fechar(); });
</script>

<%- include("partials/footer") %>
