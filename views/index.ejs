<%- include("partials/header") %>

<div class="container">
  <div class="page-header">
    <h2>Dashboard</h2>
    <p>Visão geral inicial do sistema interno.</p>
  </div>

  <div class="cards">
    <div class="card">
      <p>Empreendimentos</p>
      <div class="big-number"><%= totalEmpreendimentos %></div>
    </div>
    <div class="card">
      <p>Clientes</p>
      <div class="big-number"><%= totalClientes %></div>
    </div>
    <div class="card">
      <p>Contratos</p>
      <div class="big-number"><%= totalContratos %></div>
    </div>
  </div>

  <div class="cards">
    <div class="card">
      <p>Recebido (Confirmado)</p>
      <div class="big-number" style="color: #15803d;">R$ <%= totalEntradas.toLocaleString("pt-BR") %></div>
    </div>
    <div class="card">
      <p>A vencer (No prazo)</p>
      <div class="big-number" style="color: #1d4ed8;">R$ <%= totalPrevisto.toLocaleString("pt-BR") %></div>
      <p class="mini-stats">Parcelas ainda no prazo</p>
    </div>
    <div class="card">
      <p>Atrasado</p>
      <div class="big-number" style="color: #b91c1c;">R$ <%= totalAtrasado.toLocaleString("pt-BR") %></div>
      <p class="mini-stats">
        <% if (totalAtrasado > 0) { %>
          <span style="color: #b91c1c; font-weight: bold;">⚠️ Há valores pendentes</span>
        <% } else { %>
          Nada vencido em aberto
        <% } %>
      </p>
    </div>
  </div>

  <h3>Atalhos rápidos</h3>
  <div class="actions">
    <a href="/empreendimentos" class="button">Ver empreendimentos</a>
    <a href="/contratos" class="button secondary">Abrir contratos</a>
    <a href="/financeiro" class="button secondary">Ver financeiro</a>
  </div>
</div>

<%- include("partials/footer") %>