# Copie para .env e preencha. O .env nunca vai para o git.

PORT=3000

# Em produção, use "production": faz o cookie de sessão exigir HTTPS.
NODE_ENV=development

# --- Acesso ao sistema ---
# Senha do PRIMEIRO administrador, usada só para criá-lo na primeira subida.
# Depois disso, cada pessoa tem login próprio, criado em /usuarios.
APP_SENHA=defina-uma-senha
# Login desse primeiro administrador (padrão: admin)
# APP_ADMIN_LOGIN=admin

# Assina o cookie de sessão. Gere um valor aleatório e nunca reaproveite:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar este valor desconecta todo mundo.
SESSION_SECRET=gere-um-valor-aleatorio

# --- Integração com o n8n ---
# Precisa ser idêntico à variável APP_WEBHOOK_SECRET configurada no n8n.
# Gere um valor aleatório para produção, não reaproveite o de desenvolvimento.
WEBHOOK_SECRET=troque-por-um-valor-aleatorio

# --- Opcional ---
# GERAR_PDF=true converte o .docx em PDF (exige LibreOffice no servidor).
# GERAR_PDF=false
# LIBREOFFICE_PATH=/usr/bin/soffice
